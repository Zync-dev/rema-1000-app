@page "/profil/adgangskode"
@model Rema.App.Pages.Profile.PasswordModel
@{
    ViewData["Title"] = "Skift adgangskode";
}

<header class="page-head">
    <div>
        <a class="page-head__back" asp-page="Index"><svg class="icon"><use href="#i-arrow-left" /></svg> Min profil</a>
        <h1>Skift adgangskode</h1>
    </div>
</header>

<div class="card" style="max-width: 30rem">
    <div class="card-body">
        <form method="post" class="stack">
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div>
                <label asp-for="Input.Current" class="form-label"></label>
                <input asp-for="Input.Current" class="form-control" type="password" autocomplete="current-password" />
                <span asp-validation-for="Input.Current" class="text-danger small"></span>
            </div>
            <div>
                <label asp-for="Input.New" class="form-label"></label>
                <input asp-for="Input.New" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.New" class="text-danger small"></span>
            </div>
            <div>
                <label asp-for="Input.Confirm" class="form-label"></label>
                <input asp-for="Input.Confirm" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.Confirm" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary">Skift adgangskode</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
