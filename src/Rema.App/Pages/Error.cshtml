@page
@model ErrorModel
@{
    ViewData["Title"] = "Der opstod en fejl";
}

<div class="auth-wrap text-center">
    <svg class="icon icon--lg text-muted mb-2"><use href="#i-alert" /></svg>
    <h1 class="h4">Der opstod en fejl</h1>
    <p class="text-muted">Noget gik galt under behandlingen af din anmodning. Prøv igen om lidt.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }
    <a asp-page="/Index" class="btn btn-primary mt-2">Til oversigten</a>
</div>
