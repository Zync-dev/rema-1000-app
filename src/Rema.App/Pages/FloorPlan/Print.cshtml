@page "/gulvplan/{id:guid}/print"
@using Rema.App.Data.Entities
@model Rema.App.Pages.FloorPlan.PrintModel
@{
    ViewData["Title"] = $"Print · {Model.Plan.Name}";
    Layout = null;
    var w = Model.Plan.CanvasWidth;
    var h = Model.Plan.CanvasHeight;

    string CellText(FloorBox b, bool second) => (second ? b.OfferB : b.Offer) ?? "";

    string ShapeSvg(FloorShape s)
    {
        // s.Color er allerede valideret mod paletten i FloorShapes.Sanitize.
        var c = s.Color;
        if (s.Kind == "rect" && s.Points.Count >= 2)
        {
            var x = Math.Min(s.Points[0][0], s.Points[1][0]);
            var y = Math.Min(s.Points[0][1], s.Points[1][1]);
            var rw = Math.Abs(s.Points[1][0] - s.Points[0][0]);
            var rh = Math.Abs(s.Points[1][1] - s.Points[0][1]);
            return $"<rect x=\"{x:0.#}\" y=\"{y:0.#}\" width=\"{rw:0.#}\" height=\"{rh:0.#}\" fill=\"none\" stroke=\"{c}\" stroke-width=\"{s.Width}\" />";
        }
        var pts = string.Join(" ", s.Points.Select(p => $"{p[0]:0.#},{p[1]:0.#}"));
        return $"<polyline points=\"{pts}\" fill=\"none\" stroke=\"{c}\" stroke-width=\"{s.Width}\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />";
    }
}
<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <title>@Model.Headline – gulvplan</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        @@page { size: A4 landscape; margin: 8mm; }
        body { background: #eceae3; font-family: "Inter", system-ui, sans-serif; margin: 0; padding: 24px; }

        .toolbar { width: 281mm; max-width: 100%; margin: 0 auto 16px; display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
        .toolbar .grow { flex: 1 1 260px; }
        .toolbar label { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #6b7280; display: block; margin-bottom: 3px; }

        /* Ét ark = A4 landscape brugbart areal (297×210mm − 8mm margen hele vejen rundt).
           Alt er absolut placeret, så layoutet er identisk på skærm og i print. */
        .sheet {
            position: relative;
            width: 281mm;
            height: 194mm;
            margin: 0 auto;
            background: #fff;
            box-shadow: 0 6px 24px rgba(20,30,50,.14);
            box-sizing: border-box;
            overflow: hidden;
        }
        .sheet__head {
            position: absolute; top: 6mm; left: 8mm; right: 8mm; height: 12mm;
            display: flex; justify-content: space-between; align-items: baseline;
            border-bottom: 2px solid #0a4d9c;
        }
        .sheet__head h1 { font-size: 20px; margin: 0; color: #16213a; }
        .sheet__head .meta { font-size: 12px; color: #6b7280; }

        /* Fast rektangel til tegningen – hverken flex eller indhold styrer højden. */
        .plan-area {
            position: absolute; left: 8mm; right: 8mm; top: 21mm; bottom: 30mm;
            overflow: hidden;
        }
        .sheet.no-notes .plan-area { bottom: 8mm; }
        .plan {
            position: absolute; top: 0; left: 0;
            width: @(w)px; height: @(h)px;
            transform-origin: 0 0;
            transform: translate(var(--tx, 0px), var(--ty, 0px)) scale(var(--s, 0.4));
            background: #fff;
        }
        .plan-area { border: 1.5px solid #333; }
        .plan-shapes { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
        .pbox {
            position: absolute; border: 1.5px solid #333; border-radius: 4px;
            overflow: hidden; background: #fff;
            display: flex; flex-direction: column;
        }
        .pbox.hl { background: #fff6e0; border-color: #e2231a; }
        .pbox .tag {
            flex: none; background: #0a4d9c; color: #fff;
            font-size: 11px; font-weight: 800; line-height: 1.4; padding: 0 6px; letter-spacing: .02em;
        }
        .pbox.hl .tag { background: #e2231a; }
        .pcells { flex: 1 1 auto; display: flex; min-height: 0; }
        .pcells.tb { flex-direction: column; }
        .pcell {
            flex: 1; min-width: 0; min-height: 0; padding: 3px 6px; overflow: hidden;
            font-size: 13px; font-weight: 600; line-height: 1.25;
            display: flex; align-items: center; word-break: break-word;
        }
        .pcells.lr .pcell + .pcell { border-left: 1.5px dashed #0a4d9c; }
        .pcells.tb .pcell + .pcell { border-top: 1.5px dashed #0a4d9c; }

        .sheet__notes {
            position: absolute; left: 8mm; right: 8mm; bottom: 6mm; height: 22mm;
            font-size: 12px; color: #333; white-space: pre-wrap;
            border-top: 1px solid #ddd; padding-top: 6px; overflow: hidden;
        }
        .sheet__notes:empty { display: none; }

        .parts { width: 281mm; max-width: 100%; margin: 26px auto 0; }
        .parts h2 { font-size: 15px; }
        .parts table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .parts th { text-align: left; font-size: .7rem; text-transform: uppercase; letter-spacing: .06em; color: #888; border-bottom: 1.5px solid #ccc; padding: 6px 8px; }
        .parts td { padding: 6px 8px; border-bottom: 1px solid #eee; }

        @@media print {
            body { background: #fff; padding: 0; }
            .no-print { display: none !important; }
            /* Behold arkets faste mål – IKKE 100%/auto, ellers falder højden sammen
               og tegningen skaleres til 0. */
            .sheet { box-shadow: none; margin: 0; }
            .parts { page-break-before: always; margin: 0; }
        }
    </style>
</head>
<body>
    <partial name="_Icons" />

    <form class="toolbar no-print" method="post" asp-page-handler="Settings" asp-route-id="@Model.Plan.Id">
        <div class="grow">
            <label>Overskrift</label>
            <input name="headline" class="form-control form-control-sm" value="@(Model.Plan.PrintHeadline ?? Model.Plan.Name)" />
        </div>
        <div class="grow">
            <label>Noter (printes under tegningen)</label>
            <textarea name="notes" class="form-control form-control-sm" rows="1">@Model.Plan.PrintNotes</textarea>
        </div>
        <button type="submit" class="btn btn-outline-secondary btn-sm">Gem</button>
        <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">
            <svg class="icon"><use href="#i-print" /></svg> Print
        </button>
    </form>

    <div class="sheet @(string.IsNullOrWhiteSpace(Model.Plan.PrintNotes) ? "no-notes" : "")">
        <div class="sheet__head">
            <h1>@Model.Headline</h1>
            <div class="meta">@Model.Plan.Name · @DateTime.Now.ToString("dd-MM-yyyy")</div>
        </div>

        <div class="plan-area">
            <div class="plan" id="plan">
                @if (Model.Shapes.Count > 0)
                {
                    <svg class="plan-shapes" viewBox="0 0 @w @h" xmlns="http://www.w3.org/2000/svg">
                        @foreach (var s in Model.Shapes)
                        {
                            @Html.Raw(ShapeSvg(s))
                        }
                    </svg>
                }
                @foreach (var b in Model.Boxes)
                {
                    var splitCls = b.Split == SplitMode.LeftRight ? "lr" : b.Split == SplitMode.TopBottom ? "tb" : "";
                    <div class="pbox @(b.Highlight ? "hl" : "")"
                         style="left:@(b.X)px;top:@(b.Y)px;width:@(b.Width)px;height:@(b.Height)px">
                        <span class="tag">@b.Label</span>
                        <div class="pcells @splitCls">
                            <div class="pcell">@CellText(b, false)</div>
                            @if (b.Split != SplitMode.None)
                            {
                                <div class="pcell">@CellText(b, true)</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="sheet__notes">@Model.Plan.PrintNotes</div>
    </div>

    <div class="parts">
        <h2>Placeringer</h2>
        <table>
            <thead><tr><th style="width:70px">Nr.</th><th style="width:120px">Type</th><th>Ugens vare</th></tr></thead>
            <tbody>
            @foreach (var b in Model.Boxes)
            {
                <tr>
                    <td><strong>@b.Label</strong></td>
                    <td>@Rema.App.Pages.FloorPlan.PrintModel.KindLabel(b.Kind) @(b.Height > b.Width ? "(roteret)" : "")</td>
                    <td>
                        @if (b.Split == SplitMode.None)
                        {
                            @b.Offer
                        }
                        else
                        {
                            <span>@Rema.App.Pages.FloorPlan.PrintModel.SplitLabelA(b.Split): @b.Offer</span>
                            <br />
                            <span>@Rema.App.Pages.FloorPlan.PrintModel.SplitLabelB(b.Split): @b.OfferB</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <script>
        // Zoom ind på de faktiske placeringer, så tegningen ALTID fylder ét ark –
        // uanset hvor stort lærredet er sat til.
        (function () {
            var PLAN_W = @w, PLAN_H = @h;
            var plan = document.getElementById("plan");

            function contentBox() {
                var x1 = Infinity, y1 = Infinity, x2 = -Infinity, y2 = -Infinity, any = false;
                plan.querySelectorAll(".pbox").forEach(function (el) {
                    var x = parseFloat(el.style.left) || 0, y = parseFloat(el.style.top) || 0;
                    var w = parseFloat(el.style.width) || 0, h = parseFloat(el.style.height) || 0;
                    x1 = Math.min(x1, x); y1 = Math.min(y1, y);
                    x2 = Math.max(x2, x + w); y2 = Math.max(y2, y + h);
                    any = true;
                });
                var svg = plan.querySelector(".plan-shapes");
                if (svg) {
                    try {
                        var bb = svg.getBBox();
                        if (bb.width || bb.height) {
                            x1 = Math.min(x1, bb.x); y1 = Math.min(y1, bb.y);
                            x2 = Math.max(x2, bb.x + bb.width); y2 = Math.max(y2, bb.y + bb.height);
                            any = true;
                        }
                    } catch (e) { /* ingen former */ }
                }
                if (!any) return { x: 0, y: 0, w: PLAN_W, h: PLAN_H };
                var padX = Math.max(25, (x2 - x1) * 0.05);
                var padY = Math.max(25, (y2 - y1) * 0.05);
                x1 = Math.max(0, x1 - padX); y1 = Math.max(0, y1 - padY);
                x2 = Math.min(PLAN_W, x2 + padX); y2 = Math.min(PLAN_H, y2 + padY);
                return { x: x1, y: y1, w: Math.max(1, x2 - x1), h: Math.max(1, y2 - y1) };
            }

            // Skru ned for celle-teksten hvis den ikke kan være i boksen.
            function fitText() {
                plan.querySelectorAll(".pcell").forEach(function (cell) {
                    var fs = 13;
                    cell.style.fontSize = fs + "px";
                    var guard = 0;
                    while (fs > 7 && guard++ < 20 &&
                           (cell.scrollHeight > cell.clientHeight + 1 || cell.scrollWidth > cell.clientWidth + 1)) {
                        fs -= 0.5;
                        cell.style.fontSize = fs + "px";
                    }
                });
            }

            function fit() {
                var area = document.querySelector(".plan-area");
                var aw = area.clientWidth, ah = area.clientHeight;
                if (aw < 10 || ah < 10) return;               // layout ikke klar

                var b = contentBox();
                var s = Math.min(aw / b.w, ah / b.h, 4);
                if (!(s > 0)) s = 0.4;

                // Placér indholdets midte i midten af tegneområdet (transform-origin 0 0).
                var tx = aw / 2 - (b.x + b.w / 2) * s;
                var ty = ah / 2 - (b.y + b.h / 2) * s;

                plan.style.setProperty("--s", s.toFixed(4));
                plan.style.setProperty("--tx", tx.toFixed(1) + "px");
                plan.style.setProperty("--ty", ty.toFixed(1) + "px");
            }

            function refresh() { fit(); fitText(); }

            refresh();
            window.addEventListener("load", refresh);
            setTimeout(refresh, 250);                          // efter fonts
            window.addEventListener("resize", refresh);
            window.addEventListener("beforeprint", refresh);
            if (window.matchMedia) {
                try { window.matchMedia("print").addEventListener("change", refresh); } catch (e) { /* Safari */ }
            }
        })();
    </script>
</body>
</html>
