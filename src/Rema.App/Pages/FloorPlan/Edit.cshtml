@page "/gulvplan/{id:guid}"
@model Rema.App.Pages.FloorPlan.EditModel
@{
    ViewData["Title"] = $"Gulvplan · {Model.Plan.Name}";
}

<header class="page-head">
    <div>
        <a class="page-head__back" asp-page="Index"><svg class="icon"><use href="#i-arrow-left" /></svg> Alle gulvplaner</a>
        <h1>@Model.Plan.Name</h1>
        @if (!string.IsNullOrEmpty(Model.Plan.Description)) { <p class="page-head__sub">@Model.Plan.Description</p> }
    </div>
    <div class="page-head__actions">
        <span id="saveStatus" class="save-status text-muted"></span>
        <button id="btnSave" class="btn btn-sm btn-primary"><svg class="icon"><use href="#i-check" /></svg> Gem</button>
        <a asp-page="Print" asp-route-id="@Model.Plan.Id" target="_blank" class="btn btn-sm btn-outline-secondary">
            <svg class="icon"><use href="#i-print" /></svg> Print
        </a>
        <form method="post" asp-page-handler="ClearOffers" asp-route-id="@Model.Plan.Id" class="m-0"
              onsubmit="return confirm('Ryd ugens tilbud på alle placeringer? Selve planen bevares.');">
            <button class="btn btn-sm btn-outline-danger">Ryd ugens tilbud</button>
        </form>
    </div>
</header>

<div class="row g-3">
    <div class="col-lg-9">
        <div class="card">
            <div class="card-body">
                <div class="editor-toolbar">
                    <div class="btn-group btn-group-sm" role="group" aria-label="Værktøj">
                        <button type="button" class="btn btn-outline-secondary tool-btn active" data-mode="select" title="Vælg og flyt">
                            <svg class="icon"><use href="#i-cursor" /></svg>
                        </button>
                        <button type="button" class="btn btn-outline-secondary tool-btn" data-mode="pen" title="Tegn frihånd">
                            <svg class="icon"><use href="#i-pencil" /></svg>
                        </button>
                        <button type="button" class="btn btn-outline-secondary tool-btn" data-mode="line" title="Linje (fx væg)">
                            <svg class="icon"><use href="#i-line" /></svg>
                        </button>
                        <button type="button" class="btn btn-outline-secondary tool-btn" data-mode="rect" title="Firkant (fx rum)">
                            <svg class="icon"><use href="#i-square" /></svg>
                        </button>
                    </div>

                    <div class="vr"></div>

                    <div id="addGroup" class="d-flex align-items-center gap-2">
                        <button id="btnAdd" class="btn btn-sm btn-primary"><svg class="icon"><use href="#i-plus" /></svg> Tilføj</button>
                        <select id="newKind" class="form-select form-select-sm w-auto">
                            @foreach (var kind in Model.Kinds)
                            {
                                <option value="@kind.Value">@kind.Label</option>
                            }
                        </select>
                    </div>

                    <div id="drawGroup" class="d-none align-items-center gap-2">
                        <span class="swatches" id="drawColors">
                            @foreach (var c in Rema.App.Pages.FloorPlan.EditModel.ShapePalette)
                            {
                                <button type="button" class="swatch" data-color="@c" style="--sw:@c" title="Farve"></button>
                            }
                        </span>
                        <select id="drawWidth" class="form-select form-select-sm w-auto">
                            <option value="3">Tynd</option>
                            <option value="6" selected>Normal</option>
                            <option value="12">Tyk</option>
                        </select>
                    </div>

                    <div class="vr"></div>
                    <label>Zoom</label>
                    <input id="zoom" type="range" min="0.2" max="1.6" step="0.05" value="0.6" class="form-range" style="width:110px" />
                    <div class="vr"></div>
                    <label>Lærred (cm)</label>
                    <input id="canvasW" type="number" class="form-control form-control-sm" style="width:76px" min="200" max="6000" />
                    <span class="text-muted">×</span>
                    <input id="canvasH" type="number" class="form-control form-control-sm" style="width:76px" min="200" max="6000" />
                </div>

                <div id="floorScroll" class="floor-scroll">
                    <div id="floor" class="floor">
                        <svg id="floorShapes" class="floor-shapes" xmlns="http://www.w3.org/2000/svg"></svg>
                    </div>
                </div>
                <p class="form-text mt-2 mb-0" id="toolHint">
                    Træk for at flytte · klik for at redigere · <kbd>Delete</kbd> sletter · <kbd>Ctrl</kbd>+scroll zoomer.
                </p>
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="card" id="inspector" hidden>
            <div class="card-body">
                <h2 class="section-title">Placering</h2>
                <div class="stack">
                    <div>
                        <label class="form-label">Nr./navn</label>
                        <input id="pLabel" class="form-control form-control-sm" maxlength="40" />
                    </div>
                    <div>
                        <label class="form-label">Type</label>
                        <select id="pKind" class="form-select form-select-sm">
                            @foreach (var kind in Model.Kinds)
                            {
                                <option value="@kind.Value">@kind.Label</option>
                            }
                        </select>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button id="btnRotate" type="button" class="btn btn-outline-secondary btn-sm">
                            <svg class="icon"><use href="#i-rotate" /></svg> Rotér 90°
                        </button>
                        <span id="pSize" class="form-text m-0"></span>
                    </div>
                    <div id="pSizeEdit" class="row g-2 d-none">
                        <div class="col-6">
                            <label class="form-label">Bredde (cm)</label>
                            <input id="pW" class="form-control form-control-sm" type="number" min="30" max="6000" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Dybde (cm)</label>
                            <input id="pH" class="form-control form-control-sm" type="number" min="30" max="6000" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Opdeling</label>
                        <select id="pSplit" class="form-select form-select-sm">
                            @foreach (var (value, label) in Rema.App.Pages.FloorPlan.EditModel.SplitOptions)
                            {
                                <option value="@value">@label</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label" id="pOfferLabel">Ugens vare</label>
                        <textarea id="pOffer" class="form-control form-control-sm" rows="2" maxlength="240" placeholder="Varenavn · pris"></textarea>
                    </div>
                    <div id="pOfferBWrap" class="d-none">
                        <label class="form-label" id="pOfferBLabel">Ugens vare (B)</label>
                        <textarea id="pOfferB" class="form-control form-control-sm" rows="2" maxlength="240"></textarea>
                    </div>
                    <div class="form-check">
                        <input id="pHighlight" type="checkbox" class="form-check-input" />
                        <label for="pHighlight" class="form-check-label">Fremhæv (kampagne/annonce)</label>
                    </div>
                    <button id="btnDelete" class="btn btn-outline-danger btn-sm w-100">
                        <svg class="icon"><use href="#i-trash" /></svg> Slet placering
                    </button>
                </div>
            </div>
        </div>
        <div class="card" id="shapeInspector" hidden>
            <div class="card-body">
                <h2 class="section-title">Tegning</h2>
                <div class="stack">
                    <div>
                        <label class="form-label">Farve</label>
                        <span class="swatches" id="shapeColors">
                            @foreach (var c in Rema.App.Pages.FloorPlan.EditModel.ShapePalette)
                            {
                                <button type="button" class="swatch" data-color="@c" style="--sw:@c"></button>
                            }
                        </span>
                    </div>
                    <div>
                        <label class="form-label">Tykkelse</label>
                        <select id="shapeWidth" class="form-select form-select-sm">
                            <option value="3">Tynd</option>
                            <option value="6">Normal</option>
                            <option value="12">Tyk</option>
                        </select>
                    </div>
                    <button id="btnDeleteShape" class="btn btn-outline-danger btn-sm w-100">
                        <svg class="icon"><use href="#i-trash" /></svg> Slet tegning
                    </button>
                </div>
            </div>
        </div>

        <p id="inspectorHint" class="text-muted small px-1">Vælg en placering for at redigere den.</p>
    </div>
</div>

<form id="afForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script id="planData" type="application/json">@Html.Raw(Model.PlanJson)</script>
    <script id="kindData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Kinds,
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))</script>
    <script>
        window.floorPlanConfig = { saveUrl: '@Url.Page("Edit", "Save", new { id = Model.Plan.Id })' };
    </script>
    <script src="~/js/floorplan.js" asp-append-version="true"></script>
}
