@page "/gulvplan/{id:guid}"
@model Rema.App.Pages.FloorPlan.EditModel
@{
    ViewData["Title"] = $"Gulvplan · {Model.Plan.Name}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <a asp-page="Index" class="text-decoration-none small">&larr; Alle gulvplaner</a>
        <h1 class="h4 mb-0">@Model.Plan.Name</h1>
        @if (!string.IsNullOrEmpty(Model.Plan.Description)) { <div class="text-muted small">@Model.Plan.Description</div> }
    </div>
    <div class="d-flex align-items-center gap-2">
        <span id="saveStatus" class="small text-muted"></span>
        <button id="btnSave" class="btn btn-primary btn-sm">Gem</button>
        <a asp-page="Print" asp-route-id="@Model.Plan.Id" target="_blank" class="btn btn-outline-secondary btn-sm">Print</a>
        <form method="post" asp-page-handler="ClearOffers" asp-route-id="@Model.Plan.Id" class="d-inline"
              onsubmit="return confirm('Ryd ugens tilbud på alle placeringer? Selve planen bevares.');">
            <button class="btn btn-outline-danger btn-sm">Ryd ugens tilbud</button>
        </form>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-9">
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <button id="btnAdd" class="btn btn-sm btn-primary">+ Placering</button>
                    <select id="newKind" class="form-select form-select-sm w-auto">
                        @foreach (var (value, label) in Model.Kinds)
                        {
                            <option value="@value">@label</option>
                        }
                    </select>
                    <span class="vr"></span>
                    <label class="small text-muted mb-0">Zoom</label>
                    <input id="zoom" type="range" min="0.3" max="1.5" step="0.05" value="0.75" class="form-range" style="width:120px" />
                    <span class="vr"></span>
                    <label class="small text-muted mb-0">Lærred</label>
                    <input id="canvasW" type="number" class="form-control form-control-sm" style="width:80px" min="200" max="4000" />
                    <span class="small">×</span>
                    <input id="canvasH" type="number" class="form-control form-control-sm" style="width:80px" min="200" max="4000" />
                </div>

                <div id="floorScroll" class="floor-scroll">
                    <div id="floor" class="floor"></div>
                </div>
                <p class="small text-muted mt-2 mb-0">
                    Træk for at flytte · træk i hjørnet for at ændre størrelse · klik for at redigere.
                </p>
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="card" id="inspector" hidden>
            <div class="card-body">
                <h2 class="h6 text-uppercase text-muted">Placering</h2>
                <div class="mb-2">
                    <label class="form-label mb-1">Nr./navn</label>
                    <input id="pLabel" class="form-control form-control-sm" maxlength="40" />
                </div>
                <div class="mb-2">
                    <label class="form-label mb-1">Type</label>
                    <select id="pKind" class="form-select form-select-sm">
                        @foreach (var (value, label) in Model.Kinds)
                        {
                            <option value="@value">@label</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label mb-1">Ugens vare</label>
                    <textarea id="pOffer" class="form-control form-control-sm" rows="3" maxlength="240"
                              placeholder="Varenavn · pris"></textarea>
                </div>
                <div class="form-check mb-3">
                    <input id="pHighlight" type="checkbox" class="form-check-input" />
                    <label for="pHighlight" class="form-check-label">Fremhæv (kampagne/annonce)</label>
                </div>
                <button id="btnDelete" class="btn btn-outline-danger btn-sm w-100">Slet placering</button>
            </div>
        </div>
        <p id="inspectorHint" class="text-muted small">Vælg en placering for at redigere den.</p>
    </div>
</div>

<form id="afForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script id="planData" type="application/json">@Html.Raw(Model.PlanJson)</script>
    <script>
        window.floorPlanConfig = {
            saveUrl: '@Url.Page("Edit", "Save", new { id = Model.Plan.Id })',
        };
    </script>
    <script src="~/js/floorplan.js" asp-append-version="true"></script>
}
