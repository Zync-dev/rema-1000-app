@page "/gulvplan"
@model Rema.App.Pages.FloorPlan.IndexModel
@{
    ViewData["Title"] = "Gulvplan";
}

<header class="page-head">
    <div>
        <h1>Gulvplaner</h1>
        <p class="page-head__sub">Én plan pr. etage eller afdeling. Placeringerne genbruges uge efter uge – kun ugens varer skiftes.</p>
    </div>
</header>

<div class="row g-4">
    <div class="col-lg-7">
        @if (Model.Plans.Count == 0)
        {
            <div class="empty-state">
                <svg class="icon icon--lg"><use href="#i-floor" /></svg>
                <h2>Ingen gulvplaner endnu</h2>
                <p>Opret din første plan i feltet til højre.</p>
            </div>
        }
        else
        {
            <div class="list-group">
                @foreach (var p in Model.Plans)
                {
                    <div class="list-group-item data-row d-flex justify-content-between align-items-center gap-3">
                        <div class="min-w-0">
                            <a class="data-row__title" asp-page="Edit" asp-route-id="@p.Id">@p.Name</a>
                            @if (!string.IsNullOrEmpty(p.Description)) { <div class="text-muted small">@p.Description</div> }
                            <div class="data-row__meta">
                                @p.BoxCount placeringer · @p.OfferCount med tilbud · opdateret @p.UpdatedUtc.ToLocalTime().ToString("dd-MM-yyyy")
                            </div>
                        </div>
                        <div class="d-flex gap-2 flex-shrink-0">
                            <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@p.Id">Rediger</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-page="Print" asp-route-id="@p.Id" target="_blank" title="Print">
                                <svg class="icon"><use href="#i-print" /></svg>
                            </a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id" onsubmit="return confirm('Slet gulvplanen og alle dens placeringer?');">
                                <button class="btn btn-sm btn-outline-danger" title="Slet"><svg class="icon"><use href="#i-trash" /></svg></button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <h2 class="section-title">Ny gulvplan</h2>
                <form method="post" class="stack">
                    <div asp-validation-summary="All" class="text-danger small"></div>
                    <div>
                        <label asp-for="Input.Name" class="form-label"></label>
                        <input asp-for="Input.Name" class="form-control" placeholder="Stueetage" />
                    </div>
                    <div>
                        <label asp-for="Input.Description" class="form-label"></label>
                        <input asp-for="Input.Description" class="form-control" placeholder="Fx kolonial + frugt/grønt" />
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <svg class="icon"><use href="#i-plus" /></svg> Opret og redigér
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
