@page
@model IndexModel
@{
    ViewData["Title"] = "Oversigt";
    var name = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="hero mb-4">
        <h1>God arbejdsdag@(string.IsNullOrEmpty(name) ? "" : ", " + name)</h1>
        <p>Vælg et værktøj herunder.</p>
    </div>

    <div class="tool-grid">
        <a asp-page="/Calculator/Index" class="tool-tile">
            <span class="tool-tile__icon"><svg class="icon icon--lg"><use href="#i-calc" /></svg></span>
            <h2>Avancekalkulator</h2>
            <p>Beregn dækningsbidrag og dækningsgrad på en vare – normal- eller tilbudspris.</p>
            <span class="tool-tile__go">Åbn <svg class="icon"><use href="#i-arrow-right" /></svg></span>
        </a>
        <a asp-page="/FloorPlan/Index" class="tool-tile">
            <span class="tool-tile__icon"><svg class="icon icon--lg"><use href="#i-floor" /></svg></span>
            <h2>Gulvplan</h2>
            <p>Planlæg hvilke kasser tilbudsvarerne skal stå i – én plan pr. etage.</p>
            <span class="tool-tile__go">Åbn <svg class="icon"><use href="#i-arrow-right" /></svg></span>
        </a>
        <a asp-page="/FacebookPost/Index" class="tool-tile">
            <span class="tool-tile__icon"><svg class="icon icon--lg"><use href="#i-megaphone" /></svg></span>
            <h2>Facebook-opslag</h2>
            <p>Generér opslag i butikkens faste stil – tilbud, konkurrencer, events.</p>
            <span class="tool-tile__go">Åbn <svg class="icon"><use href="#i-arrow-right" /></svg></span>
        </a>
    </div>
}
else
{
    <div class="hero text-center py-5">
        <h1 class="mb-2">Rema Butiksværktøjer</h1>
        <p class="mx-auto" style="max-width: 44ch">Værktøjer til den daglige drift i butikken – avancekalkulator, gulvplan og AI-Facebook-opslag. Én konto pr. butik.</p>
        <div class="d-flex justify-content-center gap-2 mt-4">
            <a asp-page="/Account/Register" class="btn btn-light btn-lg">Opret butik</a>
            <a asp-page="/Account/Login" class="btn btn-outline-light btn-lg">Log ind</a>
        </div>
    </div>
}
