@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privatliv & data";
}

<header class="page-head">
    <div>
        <h1>Privatliv &amp; data</h1>
        <p class="page-head__sub">Hvordan løsningen behandler oplysninger.</p>
    </div>
</header>

<div class="card" style="max-width: 720px">
    <div class="card-body stack">
        <p class="mb-0 text-muted">
            Denne løsning behandler oplysninger om butikkens medarbejdere (navn, e-mail, rolle)
            og driftsdata som vareberegninger, gulvplaner og Facebook-opslag.
        </p>
        <p class="mb-0 text-muted">
            Data opbevares i EU og er adskilt pr. butik, så én butik ikke kan se en anden butiks data.
            Butikkens Gemini API-nøgle gemmes krypteret og vises aldrig i klartekst.
        </p>
        <p class="mb-0 text-muted">
            Kontakt din købmand for indsigt i, rettelse af eller sletning af dine oplysninger.
        </p>
    </div>
</div>
