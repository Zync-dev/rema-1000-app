@{
    var message = TempData["StatusMessage"] as string;
}
@if (!string.IsNullOrEmpty(message))
{
    var isError = message.StartsWith("Fejl", StringComparison.OrdinalIgnoreCase);
    <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
        <svg class="icon"><use href="@(isError ? "#i-alert" : "#i-check")" /></svg>
        <span class="flex-grow-1">@message</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Luk"></button>
    </div>
}
