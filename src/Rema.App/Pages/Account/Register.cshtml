@page
@model Rema.App.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Opret butik";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Opret butik</h1>
                <p class="text-muted small">Du bliver oprettet som købmand og kan bagefter tilføje dine medarbejdere.</p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="row g-3">
                        <div class="col-sm-8">
                            <label asp-for="Input.StoreName" class="form-label"></label>
                            <input asp-for="Input.StoreName" class="form-control" placeholder="Rema 1000 Nørrebrogade" />
                            <span asp-validation-for="Input.StoreName" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="Input.StoreNumber" class="form-label"></label>
                            <input asp-for="Input.StoreNumber" class="form-control" placeholder="0123" />
                            <span asp-validation-for="Input.StoreNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Input.City" class="form-label"></label>
                            <input asp-for="Input.City" class="form-control" />
                            <span asp-validation-for="Input.City" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Input.DisplayName" class="form-label"></label>
                            <input asp-for="Input.DisplayName" class="form-control" autocomplete="name" />
                            <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.Email" class="form-label">E-mail (login)</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Input.Password" class="form-label"></label>
                            <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary mt-4">Opret butik</button>
                    <a asp-page="/Account/Login" class="btn btn-link mt-4">Jeg har allerede en konto</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
