@page
@model Rema.App.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Log ud";
}
<div class="auth-wrap">
    <div class="card">
        <div class="card-body text-center">
            <h1 class="h4 mb-3">Log ud</h1>
            <p class="text-muted">Vil du logge ud af Rema Butiksværktøjer?</p>
            <form method="post" class="mt-3">
                <button type="submit" class="btn btn-primary">Log ud</button>
                <a asp-page="/Index" class="btn btn-outline-secondary">Bliv logget ind</a>
            </form>
        </div>
    </div>
</div>
