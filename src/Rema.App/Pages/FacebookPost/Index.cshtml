@page "/facebook"
@using Rema.App.Data.Entities
@model Rema.App.Pages.FacebookPost.IndexModel
@{
    ViewData["Title"] = "Facebook-opslag";

    string TypeLabel(FacebookPostType t) => t switch
    {
        FacebookPostType.Tilbud => "Tilbud",
        FacebookPostType.Konkurrence => "Konkurrence",
        FacebookPostType.NyMedarbejder => "Ny medarbejder",
        FacebookPostType.Aabningstider => "Åbningstider",
        FacebookPostType.Event => "Event",
        _ => "Andet",
    };
    string Placeholder(FacebookPostType t) => t switch
    {
        FacebookPostType.Tilbud => "Fx: Coca-Cola 1,5 l til 10 kr, normalpris 18 kr. Gælder tirsdag-søndag. Max 6 stk pr. kunde.",
        FacebookPostType.Konkurrence => "Fx: Vind et gavekort på 500 kr. Deltag: like opslaget og tag en ven. Vinder trækkes fredag d. [dato].",
        FacebookPostType.NyMedarbejder => "Fx: Sig velkommen til Mette, 19 år, som står i kassen og bageriet. Hun elsker håndbold.",
        FacebookPostType.Aabningstider => "Fx: Grundlovsdag 5. juni har vi åbent 8-16 i stedet for normal åbningstid.",
        FacebookPostType.Event => "Fx: Lørdag d. [dato] kl. 10-14 har vi pølsevogn og ballonuddeling foran butikken.",
        _ => "Skriv de vigtigste oplysninger her.",
    };
    string StatusPill(FacebookPostStatus s) => s switch
    {
        FacebookPostStatus.Klar => "pill pill--ok",
        FacebookPostStatus.Brugt => "pill pill--muted",
        _ => "pill pill--warn",
    };
}

<header class="page-head">
    <div>
        <h1>Facebook-opslag</h1>
        <p class="page-head__sub">Generér opslag i butikkens faste stil. AI'en finder ikke selv på priser eller datoer.</p>
    </div>
    @if (Model.CanConfigure)
    {
        <div class="page-head__actions">
            <a asp-page="Settings" class="btn btn-sm btn-outline-secondary">
                <svg class="icon"><use href="#i-settings" /></svg> Indstillinger
            </a>
        </div>
    }
</header>

@if (Model.Settings is null || !Model.Settings.HasApiKey)
{
    <div class="alert alert-warning mb-4">
        <svg class="icon"><use href="#i-alert" /></svg>
        <span class="flex-grow-1">
            Værktøjet er ikke sat op endnu.
            @if (Model.CanConfigure)
            {
                <a asp-page="Settings">Indtast butikkens API-nøgle og stil under Indstillinger.</a>
            }
            else
            {
                <text>Bed din købmand om at indtaste butikkens API-nøgle og stilprofil.</text>
            }
        </span>
    </div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <h2 class="section-title">Nyt opslag</h2>
                <form method="post" asp-page-handler="Generate" class="stack">
                    <div asp-validation-summary="All" class="text-danger small"></div>
                    <div>
                        <label class="form-label">Type</label>
                        <select asp-for="Input.PostType" class="form-select"
                                asp-items="Html.GetEnumSelectList<FacebookPostType>()"></select>
                    </div>
                    <div>
                        <label asp-for="Input.Brief" class="form-label"></label>
                        <textarea asp-for="Input.Brief" class="form-control" rows="6"
                                  placeholder="@Placeholder(Model.Input.PostType)"></textarea>
                        <div class="form-text">Skriv alt der skal med – priser, datoer, navne, betingelser.</div>
                    </div>
                    <button type="submit" class="btn btn-primary" @(Model.Settings?.HasApiKey == true ? "" : "disabled")>
                        <svg class="icon"><use href="#i-sparkles" /></svg> Generér opslag
                    </button>
                </form>
            </div>
        </div>

        @if (Model.Focus is { } f)
        {
            <div class="card mt-3" style="border-color: var(--rema-blue-100); box-shadow: var(--shadow)">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h2 class="section-title mb-0">Resultat · @TypeLabel(f.PostType)</h2>
                        <span class="small text-muted">@f.Model · @(f.InputTokens + f.OutputTokens) tokens</span>
                    </div>
                    <form method="post" asp-page-handler="Update" asp-route-id="@f.Id">
                        <textarea name="text" id="focusText" class="form-control" rows="12">@f.Text</textarea>
                        <div class="d-flex flex-wrap gap-2 mt-3 align-items-center">
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="copyText('focusText', this)">
                                <svg class="icon"><use href="#i-copy" /></svg> Kopiér
                            </button>
                            <span class="flex-grow-1"></span>
                            <select name="status" class="form-select form-select-sm w-auto">
                                @foreach (var s in Enum.GetValues<FacebookPostStatus>())
                                {
                                    <option value="@s" selected="@(s == f.Status)">@s</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm">Gem</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <h2 class="section-title">Tidligere opslag</h2>
                @if (Model.Recent.Count == 0)
                {
                    <p class="text-muted small mb-0">Ingen opslag endnu.</p>
                }
                else
                {
                    <div class="divided">
                        @foreach (var p in Model.Recent)
                        {
                            <div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="pill pill--blue">@TypeLabel(p.PostType)</span>
                                    <span class="small text-muted">@p.CreatedUtc.ToLocalTime().ToString("dd-MM HH:mm") · @p.CreatedByName</span>
                                </div>
                                <p class="mb-2 mt-2 small" style="white-space:pre-wrap; color: var(--ink-soft)">@(p.Text.Length > 240 ? p.Text[..240] + "…" : p.Text)</p>
                                <div class="d-flex gap-3 align-items-center">
                                    <span class="@StatusPill(p.Status)">@p.Status</span>
                                    <a class="muted-link small" asp-route-post="@p.Id">Åbn</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id" onsubmit="return confirm('Slet opslaget?');">
                                        <button class="btn btn-link btn-sm p-0 text-danger" style="font-size:.82rem">Slet</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function copyText(id, btn) {
            var el = document.getElementById(id);
            navigator.clipboard.writeText(el.value).then(function () {
                var t = btn.innerHTML; btn.textContent = "Kopieret!";
                setTimeout(function () { btn.innerHTML = t; }, 1500);
            });
        }
        var placeholders = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Enum.GetValues<Rema.App.Data.Entities.FacebookPostType>()
                .ToDictionary(t => t.ToString(), t => Placeholder(t))));
        var typeSel = document.querySelector('[name="Input.PostType"]');
        var brief = document.querySelector('[name="Input.Brief"]');
        if (typeSel && brief) {
            typeSel.addEventListener('change', function () {
                brief.placeholder = placeholders[typeSel.value] || '';
            });
        }
    </script>
}
